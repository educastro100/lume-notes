{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lume Notes",
  "version": "0.9.0",
  "identifier": "com.lume.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lume Notes",
        "width": 1200,
        "height": 820,
        "minWidth": 700,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#fcfbf8",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Editor de texto com abas e recuperação de rascunhos.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Eduardo Castro",
    "homepage": "https://github.com/educastro100/lume-notes-releases",
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "useLocalToolsDir": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwRjRENjM2MjIzN0UzNDUKUldSRjR6Y2lOdGIwd0ExTld6dU9yT000ZWxMcGswcnA2ckdkcjZ2dy8vaWtHS3F1a3Y3QVNQVHoK",
      "endpoints": [
        "https://github.com/educastro100/lume-notes-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
