{
  "name": "lume-notes",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run && node --test scripts/prepare-release.checks.mjs",
    "test:ci": "vitest run --maxWorkers=2 && node --test scripts/prepare-release.checks.mjs",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json src-tauri/capabilities/default.json *.md .prettierrc.json",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json src-tauri/capabilities/default.json *.md .prettierrc.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@uiw/react-codemirror": "^4.25.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
